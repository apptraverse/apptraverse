{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-debug-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "win64-ninja-msvc-debug",
      "inherits": "ninja-debug-base",
      "binaryDir": "${sourceDir}/build/win64-ninja-msvc-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "win64-vs2022-msvc-debug",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64"
      },
      "binaryDir": "${sourceDir}/build/win64-vs2022-msvc-debug"
    },
    {
      "name": "linux-x64-ninja-clang-debug",
      "inherits": "ninja-debug-base",
      "binaryDir": "${sourceDir}/build/linux-x64-ninja-clang-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-x64-ninja-appleclang-debug",
      "inherits": "ninja-debug-base",
      "binaryDir": "${sourceDir}/build/macos-x64-ninja-appleclang-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win64-ninja-msvc-debug",
      "configurePreset": "win64-ninja-msvc-debug"
    },
    {
      "name": "win64-vs2022-msvc-debug",
      "configurePreset": "win64-vs2022-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-ninja-clang-debug",
      "configurePreset": "linux-x64-ninja-clang-debug"
    },
    {
      "name": "macos-x64-ninja-appleclang-debug",
      "configurePreset": "macos-x64-ninja-appleclang-debug"
    }
  ]
}
