# Opt-in shipping profile, applied before dependency targets are created.
option(APPTRAVERSE_MINIMUM_64 "Minimal 64-bit shipping consumers" OFF)
if(NOT APPTRAVERSE_MINIMUM_64)
  return()
endif()
include_guard(GLOBAL)
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "APPTRAVERSE_MINIMUM_64 requires 64-bit pointers (Web: MEMORY64=1)")
endif()
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_MINSIZEREL ON)
set(CMAKE_POLICY_DEFAULT_CMP0069 NEW)
set(AE_OBJECTS_RAW_TELE OFF CACHE BOOL "No raw debug telemetry in shipping consumers" FORCE)
set(AE_MINIMAL_HYDROGEN ON CACHE BOOL "Use only the selected Hydrogen crypto backend" FORCE)
set(AE_NATIVE_WEBSOCKET OFF CACHE BOOL "Native minimum profile uses TCP directly" FORCE)
add_compile_definitions("$<$<CONFIG:MinSizeRel>:AE_TELE_ENABLED=0>")
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:DebugDLL>")
if(MSVC)
  add_compile_options("$<$<CONFIG:MinSizeRel>:/O1;/Ob1;/Oi;/Os;/Oy;/GL;/Gy;/Gw;/GF;/GS-;/d2Qvec-;/fp:fast;/fp:except->"
    "$<$<AND:$<CONFIG:MinSizeRel>,$<COMPILE_LANGUAGE:CXX>>:/GR-;/EHs-c->")
  add_compile_definitions("$<$<AND:$<CONFIG:MinSizeRel>,$<COMPILE_LANGUAGE:CXX>>:_HAS_EXCEPTIONS=0>")
  add_link_options("$<$<CONFIG:MinSizeRel>:/LTCG;/OPT:REF;/OPT:ICF=5;/INCREMENTAL:NO;/GUARD:NO>")
else()
  add_compile_options("$<$<CONFIG:MinSizeRel>:-Oz;-ffunction-sections;-fdata-sections;-fno-stack-protector;-ffast-math;-fno-math-errno;-fno-trapping-math;-fomit-frame-pointer>"
    "$<$<AND:$<CONFIG:MinSizeRel>,$<COMPILE_LANGUAGE:CXX>>:-fno-rtti;-fno-exceptions>")
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    add_compile_options("$<$<CONFIG:MinSizeRel>:-fno-vectorize;-fno-slp-vectorize>")
  else()
    add_compile_options("$<$<CONFIG:MinSizeRel>:-fno-tree-vectorize;-fno-tree-slp-vectorize>")
  endif()
  if(EMSCRIPTEN)
    add_compile_options("$<$<CONFIG:MinSizeRel>:-mno-simd128>")
    add_link_options("$<$<CONFIG:MinSizeRel>:-Oz;-fno-rtti;-fno-exceptions;-sASSERTIONS=0;-sSTACK_OVERFLOW_CHECK=0>")
  elseif(APPLE)
    add_link_options("$<$<CONFIG:MinSizeRel>:-Wl,-dead_strip;-Wl,-S>")
  else()
    add_link_options("$<$<CONFIG:MinSizeRel>:-Wl,--gc-sections;-Wl,--strip-all>")
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|amd64" OR ANDROID_ABI STREQUAL "x86_64")
      # SSE2 is part of the x86-64 scalar floating-point ABI; disable extensions
      # and auto-vectorization rather than generating an invalid calling ABI.
      add_compile_options("$<$<CONFIG:MinSizeRel>:-mno-avx;-mno-avx2;-mno-sse3;-mno-ssse3;-mno-sse4.1;-mno-sse4.2>")
    endif()
  endif()
endif()
