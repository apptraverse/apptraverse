--- /dev/null
+++ b/aether/fail_without_exceptions.h
@@ -0,0 +1,17 @@
+#ifndef AETHER_FAIL_WITHOUT_EXCEPTIONS_H_
+#define AETHER_FAIL_WITHOUT_EXCEPTIONS_H_
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace ae {
+
+[[noreturn]] inline void FailWithoutExceptions(char const* message) {
+  std::fputs(message, stderr);
+  std::fputc('\n', stderr);
+  std::abort();
+}
+
+}  // namespace ae
+
+#endif  // AETHER_FAIL_WITHOUT_EXCEPTIONS_H_
