+  for (auto const size : kPayloadSizes) {
+    auto const packet = PackSafeStreamClientSend(
+        0x1234, 0xABCD, 9, DataBuffer(size, 0x5A));
+    TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(size) == packet.size());
+  }
+}
+
+void test_BudgetChoosesLargestPayloadThatActuallyPacks() {
+  constexpr std::array<std::size_t, 18> kBudgets{
+      0, 1, 6, 7, 8, 31, 127, 128, 250,
+      251, 252, 1200, 1450, 1500, 1514, 1515, 65535, 65536};
+  auto const empty_size = PackSafeStreamClientSend(0, 0, 0, {}).size();
+  for (auto const budget : kBudgets) {
+    auto const payload = MaxSafeStreamSendDataBytesForPackedSendBudget(budget);
+    TEST_ASSERT_TRUE(
+        payload == MaxSafeStreamSendDataBytesForDownstreamMaxElementSize(budget));
+    if (budget < empty_size) {
+      TEST_ASSERT_TRUE(payload == 0);
+      continue;
+    }
+    auto const packet = PackSafeStreamClientSend(0, 0, 0, DataBuffer(payload));
+    auto const next_packet =
+        PackSafeStreamClientSend(0, 0, 0, DataBuffer(payload + 1));
+    TEST_ASSERT_TRUE(packet.size() <= budget);
+    TEST_ASSERT_TRUE(next_packet.size() > budget);
+  }
+}
+
+void test_TcpUint32MaxBudgetDoesNotMaterializePayload() {
+  constexpr auto kTcpBudget =
+      static_cast<std::size_t>(std::numeric_limits<std::uint32_t>::max());
+  // This operation previously allocated and packed gigabytes just to obtain a
+  // length. Its result now uses a stack count prefix and must remain uncapped.
+  auto const payload = MaxSafeStreamSendDataBytesForPackedSendBudget(kTcpBudget);
+  TEST_ASSERT_TRUE(payload == kTcpBudget - 6 - PackedSize::kMaxWireBytes);
+  TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(payload) == kTcpBudget);
+  if constexpr (sizeof(std::size_t) > sizeof(std::uint32_t)) {
+    TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(payload + 1) > kTcpBudget);
+    TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(kTcpBudget) > kTcpBudget);
+  } else {
+    TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(payload + 1) == kTcpBudget);
+    TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(kTcpBudget) == kTcpBudget);
+  }
+}
+
+void test_SizeMaxBudgetAndOverflowDoNotWrap() {
+  constexpr auto kSizeMax = std::numeric_limits<std::size_t>::max();
+  auto const payload = MaxSafeStreamSendDataBytesForPackedSendBudget(kSizeMax);
+  auto const expected = static_cast<std::size_t>(std::min<std::uint64_t>(
+      PackedSize::kUpper, kSizeMax - 6 - PackedSize::kMaxWireBytes));
+  TEST_ASSERT_TRUE(payload == expected);
+  TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(payload) ==
+                   payload + 6 + PackedSize::kMaxWireBytes);
+  TEST_ASSERT_TRUE(PackedSafeStreamSendBytes(kSizeMax) == kSizeMax);
+}
+
+}  // namespace ae::test_safe_stream_wire_budget
+
+int test_safe_stream_wire_budget() {
+  UNITY_BEGIN();
+  RUN_TEST(ae::test_safe_stream_wire_budget::
+               test_SizeMatchesActualSendAtLengthPrefixBoundaries);
+  RUN_TEST(ae::test_safe_stream_wire_budget::
+               test_BudgetChoosesLargestPayloadThatActuallyPacks);
+  RUN_TEST(ae::test_safe_stream_wire_budget::
+               test_TcpUint32MaxBudgetDoesNotMaterializePayload);
+  RUN_TEST(ae::test_safe_stream_wire_budget::test_SizeMaxBudgetAndOverflowDoNotWrap);
+  return UNITY_END();
+}
