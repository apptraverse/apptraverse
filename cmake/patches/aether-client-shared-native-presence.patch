+
+#include "aether/safe_stream/safe_stream_wire_budget.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+
+#include "aether/api_protocol/api_protocol.h"
+#include "aether/safe_stream/details/safe_stream_client_api.h"
+#include "aether/types/packed_size.h"
+
+namespace ae {
+namespace safe_stream_wire_budget_internal {
+
+// Send is encoded as MessageId, begin_offset, delta_offset, repeat_count and
+// a DataBuffer. BinaryArchive writes the fixed-width fields without padding;
+// VectorBuffer<PackedSize> supplies the DataBuffer's count prefix.
+constexpr std::size_t kFixedSendBytes =
+    sizeof(MessageId) + 2 * sizeof(std::uint16_t) + sizeof(std::uint8_t);
+
+std::size_t DataSizePrefixBytes(std::size_t size) noexcept {
+  std::uint8_t prefix[PackedSize::kMaxWireBytes];
+  return PackedSize{size}.Serialize(prefix);
+}
+
+}  // namespace safe_stream_wire_budget_internal
+
+DataBuffer PackSafeStreamClientSend(std::uint16_t begin_offset,
+                                    std::uint16_t delta_offset,
+                                    std::uint8_t repeat_count,
+                                    DataBuffer data) {
+  SafeStreamApiClient client;
+  ApiContext context{client};
+  context->Send(begin_offset, delta_offset, repeat_count, std::move(data));
+  return std::move(context).Pack();
+}
+
+std::size_t PackedSafeStreamSendBytes(std::size_t send_data_bytes) noexcept {
+  namespace budget = safe_stream_wire_budget_internal;
+  if (send_data_bytes > PackedSize::kUpper) {
+    return std::numeric_limits<std::size_t>::max();
+  }
+  auto const overhead =
+      budget::kFixedSendBytes + budget::DataSizePrefixBytes(send_data_bytes);
+  if (send_data_bytes > std::numeric_limits<std::size_t>::max() - overhead) {
+    return std::numeric_limits<std::size_t>::max();
+  }
+  return send_data_bytes + overhead;
+}
+
+std::size_t MaxSafeStreamSendDataBytesForPackedSendBudget(
+    std::size_t max_packed_send_bytes) noexcept {
+  namespace budget = safe_stream_wire_budget_internal;
+  if (PackedSafeStreamSendBytes(0) > max_packed_send_bytes) {
+    return 0;
+  }
+  std::size_t lo = 0;
+  // Subtract the smallest wire overhead before choosing a midpoint. This also
+  // keeps the binary search arithmetic valid for a SIZE_MAX stream budget.
+  std::size_t hi = static_cast<std::size_t>(std::min<std::uint64_t>(
+      max_packed_send_bytes - budget::kFixedSendBytes - 1, PackedSize::kUpper));
+  while (lo < hi) {
+    std::size_t mid = lo + (hi - lo + 1) / 2;
+    auto const overhead =
+        budget::kFixedSendBytes + budget::DataSizePrefixBytes(mid);
+    if (overhead <= max_packed_send_bytes &&
+        mid <= max_packed_send_bytes - overhead) {
+      lo = mid;
+    } else {
+      hi = mid - 1;
+    }
+  }
+  return lo;
+}
+
+std::size_t MaxSafeStreamSendDataBytesForDownstreamMaxElementSize(
+    std::size_t downstream_max_element_size) noexcept {
+  return MaxSafeStreamSendDataBytesForPackedSendBudget(
+      downstream_max_element_size);
+}
+
+}  // namespace ae
