+      return {0, 0};
+    }
+    auto const& p = *it->second;
+    unsigned mask = (p.ping_ && p.ping_->IsPending() ? 1U : 0U) |
+                    (p.AwaitingLatePing() ? 2U : 0U) |
+                    (p.start_sub_ ? 4U : 0U) | (p.link_state_sub_ ? 8U : 0U) |
+                    (p.ping_deferred_sub_ ? 16U : 0U) |
+                    (p.ping_finish_sub_ ? 32U : 0U) | (p.stop_ ? 64U : 0U) |
+                    (p.ping_ ? 128U : 0U);
+    return {mask, std::chrono::duration_cast<std::chrono::milliseconds>(
+                      p.next_ping_time_ - Now())
+                      .count()};
+  }
   static void TriggerPeriodicStart(PingCloudServers& pcs, ServerId server_id);
   static bool HasPendingClientPing(PingCloudServers& pcs, ServerId server_id);
   static bool HasAwaitingLateClientPing(PingCloudServers& pcs,
                                         ServerId server_id);
   static Ping const* ClientPingPtr(PingCloudServers& pcs, ServerId server_id);
   static void StopServerPing(PingCloudServers& pcs, ServerId server_id);
+  static void DropScheduledStart(PingCloudServers& pcs, ServerId server_id);
+  static void StrandScheduledStart(PingCloudServers& pcs, ServerId server_id);
 };
 
