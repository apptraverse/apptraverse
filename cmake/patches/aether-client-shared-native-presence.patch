+              cc->stream_info().link_state != LinkState::kLinked) {
+            return;
+          }
+          auto it = server_pings_.find(sc->server_id());
+          if (it == server_pings_.end() || it->second->stopped()) {
+            AE_BENCH_CONN_DIAG("ping_idle_restart", sc->server_id(),
+                               sc->bench_cloud_instance_id(),
+                               cc->bench_client_instance_id(), 0, 0, 0, -1, 0,
+                               -1);
+            ReconcileServer(*sc);
+          } else {
+            it->second->ResumeIfIdle();
+          }
+        },
+        policy_->rx_targets());
+  });
+  if (!resume_sub_) {
+    AE_TELED_ERROR("Failed to schedule idle server ping recovery");
+    assert(false && "failed to schedule idle server ping recovery");
+  }
+}
 
