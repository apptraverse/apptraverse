+Ptr<Obj> DomainGraph::MaterializeShell(ObjId obj_id) {
+  Ptr<Obj> ptr;
+  if (MaterializeShell(obj_id, ptr).IsErr()) {
+    return {};
+  }
+  return ptr;
+}
+
+seri::SeriResult DomainGraph::MaterializeShell(ObjId obj_id, Ptr<Obj>& ptr) {
+  if (!obj_id.is_valid()) {
+    return Error{seri::read_error};
+  }
+  if (ptr = domain->Find(obj_id); ptr) {
+    return Ok{seri::good};
+  }
+  auto* factory = domain->GetMostRelatedFactory(obj_id);
+  if (factory == nullptr) {
+    return Error{seri::read_error};
+  }
+  ptr = domain->ConstructObj(*factory, obj_id);
+  if (!ptr) {
+    return Error{seri::read_error};
+  }
+  return Ok{seri::good};
+}
+
+seri::SeriResult DomainGraph::HydrateShellFromStorage(Ptr<Obj>& obj,
+                                                      ObjId storage_id) {
+  if (!obj) {
+    return Error{seri::read_error};
+  }
+  LoadStoredLayers(obj, storage_id);
+  if (!obj) {
+    return Error{seri::read_error};
+  }
+  return Ok{seri::good};
+}
