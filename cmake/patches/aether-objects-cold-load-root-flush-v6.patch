+DomainLoadRootState& DomainGraph::LoadRootState() const {
+  assert(domain && domain->load_root_state_);
+  return *domain->load_root_state_;
+}
+
+void DomainGraph::FlushIncompleteStoredLayers() {
+  CompleteAllPendingStoredLayers();
+}
+
+void DomainGraph::EnsureStoredLayersLoaded(ObjId storage_id) {
+  if (!domain->Find(storage_id)) {
+    return;
+  }
+  CompletePendingStoredLayersFor(storage_id);
+  CompleteAllPendingStoredLayers();
+  if (LoadRootState().pending_stored_layers.count(storage_id.id()) != 0) {
+    return;
+  }
+  Ptr<Obj> obj = domain->Find(storage_id);
+  LoadStoredLayers(obj, storage_id);
+  CompletePendingStoredLayersFor(storage_id);
+  CompleteAllPendingStoredLayers();
+}
+
+bool DomainGraph::HasIncompleteStoredLayers() const {
+  return !LoadRootState().pending_stored_layers.empty();
+}
+
+bool DomainGraph::TryLoadStoredLayer(Ptr<Obj>& obj, ObjId storage_id,
+                                      std::uint32_t class_id, bool& loaded) {
+  loaded = false;
+  auto* layer = domain->FindClassFactory(class_id);
+  assert(layer && layer->load);
+  auto result = layer->load(this, obj, storage_id);
+  if (!result) {
+    return true;
+  }
+  if (result->IsErr()) {
+    domain->RemoveObject(obj.get());
+    obj.Reset();
+    return false;
+  }
+  loaded = true;
+  return true;
+}
+
+void DomainGraph::EnqueuePendingStoredLayers(
+    ObjId storage_id, std::vector<std::uint32_t> const& class_ids) {
+  if (class_ids.empty()) {
+    return;
+  }
+  auto& pending = LoadRootState().pending_stored_layers[storage_id.id()];
+  pending.insert(pending.end(), class_ids.begin(), class_ids.end());
+}
+
+void DomainGraph::CompletePendingStoredLayersFor(ObjId storage_id) {
+  auto& layers = LoadRootState().pending_stored_layers;
+  auto it = layers.find(storage_id.id());
+  if (it == layers.end()) {
+    return;
+  }
+  Ptr<Obj> obj = domain->Find(storage_id);
+  if (!obj) {
+    return;
+  }
+  std::vector<std::uint32_t> still;
+  for (auto const class_id : it->second) {
+    bool loaded = false;
+    if (!TryLoadStoredLayer(obj, storage_id, class_id, loaded)) {
+      return;
+    }
+    if (!loaded) {
+      still.push_back(class_id);
+    }
+  }
+  if (still.empty()) {
+    layers.erase(it);
+  } else {
+    it->second = std::move(still);
+  }
+}
+
+void DomainGraph::CompleteAllPendingStoredLayers() {
+  auto& layers = LoadRootState().pending_stored_layers;
+  bool progress = true;
+  while (progress && !layers.empty()) {
+    progress = false;
+    auto snapshot = layers;
+    layers.clear();
+    for (auto const& entry : snapshot) {
+      ObjId const storage_id{entry.first};
+      Ptr<Obj> obj = domain->Find(storage_id);
+      if (!obj) {
+        layers[entry.first] = entry.second;
+        continue;
+      }
+      std::vector<std::uint32_t> still;
+      for (auto const class_id : entry.second) {
+        bool loaded = false;
+        if (!TryLoadStoredLayer(obj, storage_id, class_id, loaded)) {
+          return;
+        }
+        if (!loaded) {
+          still.push_back(class_id);
+        } else {
+          progress = true;
+        }
+      }
+      if (!still.empty()) {
+        layers[entry.first] = std::move(still);
+      }
+    }
+  }
+}
