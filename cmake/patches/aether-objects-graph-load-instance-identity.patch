diff --git a/src/aether-objects/obj/domain.h b/src/aether-objects/obj/domain.h
index 579ff7e..c3e7dff 100644
--- a/src/aether-objects/obj/domain.h
+++ b/src/aether-objects/obj/domain.h
@@ -78,6 +78,16 @@ struct DomainCycleDetector {
     return ok;
   }
 
+  void Remove(ObjId obj_id) {
+    for (auto it = visited_nodes.begin(); it != visited_nodes.end();) {
+      if (it->id == obj_id) {
+        it = visited_nodes.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
+
   std::set<Node> visited_nodes;
 };
 
