diff --git a/src/aether-objects/obj/obj.cpp b/src/aether-objects/obj/obj.cpp
index aaca824..cb60a41 100644
--- a/src/aether-objects/obj/obj.cpp
+++ b/src/aether-objects/obj/obj.cpp
@@ -18,7 +18,46 @@
 
 #include "aether-miscpp/crc.h"
 
+#include "aether-objects/obj/domain.h"
+#include "aether-objects/obj/registry.h"
+
 namespace ae {
+
+Ptr<Obj> ObjFacetFactoryCreateMustNotRun() { return {}; }
+
+std::optional<seri::SeriResult> LoadObjOriginFacet(DomainGraph* domain_graph,
+                                                   Ptr<Obj>& obj,
+                                                   ObjId storage_id) {
+  auto result = domain_graph->LoadVersion(
+      Version<1>{}, static_cast<Obj&>(*obj.get()), storage_id);
+  if (IsMissingVersion(result)) {
+    return Ok{seri::good};
+  }
+  return result;
+}
+
+std::optional<seri::SeriResult> SaveObjOriginFacetUnused(DomainGraph*,
+                                                         Ptr<Obj> const&,
+                                                         ObjId) {
+  return Ok{seri::good};
+}
+
+void RegisterObjOriginFacetFactory(Registry& registry) {
+  if (registry.IsExisting(Obj::kClassId)) {
+    return;
+  }
+  registry.RegisterClass(
+      Obj::kClassId, Obj::kClassId,
+      Factory{ObjFacetFactoryCreateMustNotRun, LoadObjOriginFacet,
+              SaveObjOriginFacetUnused,
+#ifndef NDEBUG
+              std::string{"ae::Obj"},
+              Obj::kClassId,
+              Obj::kClassId,
+#endif
+      });
+}
+
 Obj::Obj() = default;
 
 Obj::Obj(ObjProp prop) : domain{prop.domain}, obj_id{prop.id} {}
