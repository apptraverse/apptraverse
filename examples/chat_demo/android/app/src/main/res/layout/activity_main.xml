<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

  <LinearLayout
      android:id="@+id/new_chat_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <EditText
        android:id="@+id/admin_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/admin_id_hint"
        android:inputType="text"
        android:singleLine="true" />

    <EditText
        android:id="@+id/aether_uid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/aether_uid_hint"
        android:inputType="text"
        android:singleLine="true" />

    <Button
        android:id="@+id/open_peer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_peer" />
  </LinearLayout>

  <LinearLayout
      android:id="@+id/content_row"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/list_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

      <ListView
          android:id="@+id/chat_list"
          android:layout_width="match_parent"
          android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/conversation_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical">

      <ScrollView
          android:id="@+id/transcript_scroll"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1">

        <TextView
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />
      </ScrollView>

      <EditText
          android:id="@+id/draft"
          android:layout_width="match_parent"
          android:layout_height="100dp"
          android:gravity="top"
          android:hint="@string/draft_hint"
          android:inputType="textMultiLine" />

      <Button
          android:id="@+id/send_draft"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/send_draft" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/status_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/loading" />

    <TextView
        android:id="@+id/presence_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end" />
  </LinearLayout>

</LinearLayout>
