# Debug owns initial graph production. Every consumer compiles only the model
# and loads the corresponding supply prepared by that Debug producer.
function(apptraverse_add_runtime_ui_demo target dynamic supply_header_variable)
  set(_runtime_dir "${PROJECT_SOURCE_DIR}/examples/main_window_runtime_demo")
  set(_embed_dir "${CMAKE_CURRENT_BINARY_DIR}/generated_distilled")
  set(_embed "${_embed_dir}/embedded_distilled_runtime_ui_supply.h")
  set(_sources "${_runtime_dir}/windows/runtime_ui_main.cpp"
               "${_runtime_dir}/common/runtime_ui_model.cpp")
  add_executable(${target} ${_sources})
  add_executable(${target}_load_only ${_sources})
  file(MAKE_DIRECTORY "${_embed_dir}")
  if(CMAKE_BUILD_TYPE STREQUAL "Debug")
    target_compile_definitions(${target} PRIVATE APPTRAVERSE_RUNTIME_UI_DEBUG_BOOTSTRAP)
    target_sources(${target} PRIVATE "${_runtime_dir}/common/runtime_ui_supply.cpp")
    add_custom_command(OUTPUT "${_embed}"
      COMMAND $<TARGET_FILE:${target}> --distill-only "${_embed_dir}"
      DEPENDS ${target} VERBATIM)
  else()
    set(${supply_header_variable} "" CACHE FILEPATH "Matching Runtime UI supply prepared by Debug")
    if(NOT EXISTS "${${supply_header_variable}}")
      message(FATAL_ERROR "Provide the matching Debug supply through ${supply_header_variable}")
    endif()
    add_custom_command(OUTPUT "${_embed}"
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${${supply_header_variable}}" "${_embed}"
      DEPENDS "${${supply_header_variable}}" VERBATIM)
    target_sources(${target} PRIVATE "${_embed}")
    target_include_directories(${target} PRIVATE "${_embed_dir}")
  endif()
  add_custom_target(${target}_embedded_supply DEPENDS "${_embed}")
  target_sources(${target}_load_only PRIVATE "${_embed}")
  target_include_directories(${target}_load_only PRIVATE "${_embed_dir}")
  add_dependencies(${target}_load_only ${target}_embedded_supply)
  foreach(_app ${target} ${target}_load_only)
    target_link_libraries(${_app} PRIVATE apptraverse_ui_windows user32 gdi32)
    target_include_directories(${_app} PRIVATE "${_runtime_dir}/common")
    if(dynamic)
      target_compile_definitions(${_app} PRIVATE APPTRAVERSE_RUNTIME_UI_DYNAMIC)
    endif()
    if(MSVC)
      target_compile_options(${_app} PRIVATE /utf-8)
      target_compile_definitions(${_app} PRIVATE WINVER=0x0601 _WIN32_WINNT=0x0601)
      set_target_properties(${_app} PROPERTIES WIN32_EXECUTABLE TRUE)
      target_link_options(${_app} PRIVATE /ENTRY:mainCRTStartup /SUBSYSTEM:WINDOWS,6.01)
    endif()
  endforeach()
endfunction()
