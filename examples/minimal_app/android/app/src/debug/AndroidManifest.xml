<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- MainActivity only in :demo; default app process stays available for :instrumentedtests. -->
  <application>
    <activity
        android:name=".MainActivity"
        android:process=":demo" />
    <receiver
        android:name=".DemoProcessExitReceiver"
        android:exported="false"
        android:process=":demo">
      <intent-filter>
        <action android:name="com.apptraverse.minimal.action.EXIT_DEMO_PROCESS" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
